# ============================================================
#  Exemplo de variaveis de ambiente - backend_tcc
# ============================================================
# Copie este arquivo para .env e preencha com seus valores.
# NUNCA versione o .env real.

# --- Django ---
SECRET_KEY=troque-isso-por-uma-chave-secreta-aleatoria-longa
DEBUG=True

# --- PostgreSQL ---
DB_NAME=tcc_avaliacoes
DB_USER=postgres
DB_PASSWORD=sua_senha_do_postgres
DB_HOST=localhost
DB_PORT=5432

# --- E-mail (recuperacao de senha) ---
# Em desenvolvimento, deixe como console (vai imprimir no terminal):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Para producao (exemplo Gmail), comente a linha acima e use:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seu_email@gmail.com
# EMAIL_HOST_PASSWORD=sua_senha_de_app_do_gmail
# DEFAULT_FROM_EMAIL=Sistema FT-UNICAMP <seu_email@gmail.com>

# --- URL do frontend (usada nos e-mails de reset de senha) ---
FRONTEND_URL=http://localhost:5173
